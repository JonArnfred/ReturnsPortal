{
  "name": "returns-portal-frontend",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev": "node server.mjs",
    "build": "tsc --noEmit && vite build --outDir dist && vite build --ssr src/entry-server.tsx --outDir dist/server",
    "preview": "NODE_ENV=production node server.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:ssr": "node --test tests/ssr-routes.mjs tests/dashboard.mjs",
    "api:types": "openapi-typescript ../openapi/openapi.json -o src/api/schema.d.ts",
    "api:generate": "cd .. && uv run --locked python backend/scripts/export_openapi.py && cd frontend && npm run api:types"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "highcharts": "^13.1.0",
    "highcharts-react-official": "^3.2.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2"
  }
}
