# Copy to backend/.env and fill in. Keep real .env files out of git; never commit real credentials.
# Every setting and its default is in backend/app/config.py; only what you need to set is listed here.

# PostgreSQL (DATABASE_URL works instead, when DB_USERNAME is not set)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=returns_portal
DB_USERNAME=returns_portal
DB_PASSWORD=returns_portal
# DB_SSLMODE=require   # default disable; use require or verify-full for a database on another machine

# Redis (the Celery broker)
REDIS_PROTOCOL=redis://
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# Encrypts broker credentials at rest. Generate with:
# uv run python backend/scripts/generate_encryption_key.py
SECRETS_ENCRYPTION_KEY=

# The currency every portfolio is reported in (any currency with ECB reference rates, e.g. EUR, USD).
# This is the default until one is chosen under Setup > Settings in the app.
REPORTING_CURRENCY=EUR

# Interactive Brokers Flex Web Service; see documentation/BROKER_SETUP.md for the token and the query.
# Only scripts/connect_ibkr.py reads these; once connected (here or in the app) the token is stored
# encrypted and can be removed from this file.
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=

# SaxoBank OpenAPI app (authorization code grant); see documentation/BROKER_SETUP.md. live or sim.
SAXO_APP_KEY=
SAXO_APP_SECRET=
SAXO_ENVIRONMENT=live

# Optional: email the daily health check's problems (sync failures, stale data, expiring tokens).
# The mail goes to the sending account itself, over SMTP with STARTTLS.
# ALERT_SMTP_HOST=smtp.example.com
# ALERT_SMTP_PORT=587
# ALERT_EMAIL_USER=alerts@example.com
# ALERT_EMAIL_PASSWORD=

# Only when serving it beyond localhost (the app has no login; put access control in front of it).
# The frontend server answers only to localhost and the host in FRONTEND_ORIGIN, and refuses writes
# from other sites. ALLOWED_HOSTS lists the Host headers the API itself accepts; keep localhost and
# 127.0.0.1 in it, since the frontend server proxies to the API on 127.0.0.1.
# FRONTEND_ORIGIN=https://portal.example.com
# SAXO_REDIRECT_URI=https://portal.example.com/api/connections/saxo/callback
# ALLOWED_HOSTS=localhost,127.0.0.1
# CORS_ALLOWED_ORIGINS=   # only if another origin's pages must call the API directly
# FLOWER_BASIC_AUTH=user:password   # Flower login; without it dev.sh picks a random password per run
